# Server Port
PORT=8000

# Node environment: "development" | "production"
NODE_ENV=development

# MongoDB Connection String (Atlas or local)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rajmeena?appName=Cluster0
MONGO_URI=your_mongodb_connection_string_here

# Mailer Credentials (Gmail App Password)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_16_character_app_password_here

# JWT Secret Key (Generate a 32-byte random hex: openssl rand -hex 32)
SECRET_KEY=your_jwt_secret_key_here

# Frontend URL for CORS (in production)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Frontend URL for CORS (in development, optional — leave blank to allow all origins)
DEV_FRONTEND_URL=http://localhost:5173
